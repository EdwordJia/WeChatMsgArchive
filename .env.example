# 应用配置文件
# 复制此文件为 .env 并填写实际值

# ============ 微信配置 ============
# 微信数据根目录
WECHAT__WX_DATA_DIR=E:/腾讯电脑管家文件搬家/微信聊天文件搬家/Users/WeChat Files

# 微信ID
WECHAT__WXID=wxid_ucag2pjrmhm822

# 微信版本（v3 或 v4）
WECHAT__WX_VERSION=v3

# ============ 监控配置 ==========
# 监控用户列表（逗号分隔）
MONITOR__MONITOR_USERS=三叶草,编程仝芷硕,Estelle,烨林,沐光,密码机

# 监控间隔（秒，默认1800=30分钟）
MONITOR__MONITOR_INTERVAL=1800

# 分析时间范围（天）
MONITOR__ANALYSIS_DAYS=1

# ============ 数据库配置 ============
# 解密数据库输出目录
DATABASE__DECRYPTED_DB_DIR=output/decrypted_db

# 索引数据库路径
DATABASE__INDEX_DB_PATH=output/wechat_index.db
# 加密数据库目录
DATABASE__ENCRYPTED_DB_DIR=output/encrypted_db

# ========== API 配置 ============
# Anthropic API Key（用于 LLM 分析）
API__ANTHROPIC_API_KEY=your-api-key-here

# Claude 模型
API__ANTHROPIC_MODEL=claude-opus-4-20250514

# API 超时（秒）
API__API_TIMEOUT=30

# ============ 安全配置 ==========
# 数据加密主密码
SECURITY__MASTER_PASSWORD=your-strong-password

# 审计日志路径
SECURITY__AUDIT_LOG_PATH=output/security_audit.log

# 数据保留天数
SECURITY__DATA_RETENTION_DAYS=7

# ========== 看板配置 ============
# kanban-doc 根目录
KANBAN__KANBAN_ROOT=D:/develoment_home/project_home/videKanban/kanban-doc/.kanban

# ============ 应用配置 ============
# 环境（development/production）
ENVIRONMENT=development

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=output/app.log
